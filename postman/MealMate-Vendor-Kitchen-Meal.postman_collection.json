{
  "info": {
    "name": "MealMate Vendor Kitchen Meal APIs",
    "_postman_id": "d4eaf595-0d62-44c1-8d70-fce46d06ab9a",
    "description": "Postman collection for Vendor, Kitchen, and Meal Management endpoints in Gentlemee/MealMate-Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Vendors",
      "item": [
        {
          "name": "Create Vendor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Mama T Kitchen\",\n  \"description\": \"Fresh home-cooked meals\",\n  \"phone\": \"+2348012345678\",\n  \"email\": \"mamat@example.com\",\n  \"minimumPrepTimeMinutes\": 45,\n  \"deliveryRadiusKm\": 8,\n  \"dietaryTags\": [\"halal\"],\n  \"cuisines\": [\"nigerian\"],\n  \"address\": {\n    \"street\": \"12 Adeola Odeku\",\n    \"city\": \"Lagos\",\n    \"state\": \"Lagos\",\n    \"country\": \"Nigeria\",\n    \"lat\": 6.4312,\n    \"lng\": 3.4211\n  },\n  \"openingHours\": [\n    {\n      \"dayOfWeek\": 1,\n      \"opensAt\": \"08:00\",\n      \"closesAt\": \"19:00\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/vendors"
          }
        },
        {
          "name": "Get Vendors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vendors?search=&city=&state=&cuisine=&dietaryTag=&isOpenNow=",
              "host": ["{{baseUrl}}"],
              "path": ["vendors"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "city", "value": "" },
                { "key": "state", "value": "" },
                { "key": "cuisine", "value": "" },
                { "key": "dietaryTag", "value": "" },
                { "key": "isOpenNow", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Vendor By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vendors/{{vendorId}}"
          }
        },
        {
          "name": "Update Vendor",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated vendor bio\",\n  \"isOpenNow\": true,\n  \"deliveryRadiusKm\": 10\n}"
            },
            "url": "{{baseUrl}}/vendors/{{vendorId}}"
          }
        },
        {
          "name": "Delete Vendor",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": "{{baseUrl}}/vendors/{{vendorId}}"
          }
        }
      ]
    },
