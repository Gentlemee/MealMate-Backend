    {
      "name": "Meals",
      "item": [
        {
          "name": "Create Meal Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rice Meals\",\n  \"description\": \"Rice-based homemade dishes\",\n  \"icon\": \"rice-bowl\",\n  \"sortOrder\": 1,\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/meals/categories"
          }
        },
        {
          "name": "Get Meal Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/meals/categories"
          }
        },
        {
          "name": "Create Meal With Variants",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor\": \"{{vendorId}}\",\n  \"kitchen\": \"{{kitchenId}}\",\n  \"category\": \"{{categoryId}}\",\n  \"name\": \"Smoky Jollof Rice & Chicken\",\n  \"description\": \"Smoky jollof rice served with crispy fried chicken and signature pepper sauce\",\n  \"prepTimeMinutes\": 35,\n  \"dietaryTags\": [\"halal\"],\n  \"allergenTags\": [\"gluten\"],\n  \"spiceLevel\": \"medium\",\n  \"visibility\": \"published\",\n  \"variants\": [\n    {\n      \"name\": \"Regular\",\n      \"price\": 7000,\n      \"discountPrice\": 6500,\n      \"isDefault\": true,\n      \"isAvailable\": true\n    },\n    {\n      \"name\": \"Large\",\n      \"price\": 13000,\n      \"servingLabel\": \"serves 2-3\",\n      \"isAvailable\": true\n    },\n    {\n      \"name\": \"Family Pack\",\n      \"price\": 80000,\n      \"servingLabel\": \"serves 4-6\",\n      \"isAvailable\": true\n    },\n    {\n      \"name\": \"Extended Family Pack\",\n      \"price\": 140000,\n      \"servingLabel\": \"serves 7-15\",\n      \"isAvailable\": true\n    }\n  ],\n  \"availability\": {\n    \"isAvailable\": true,\n    \"dailyStock\": 20,\n    \"remainingStock\": 20,\n    \"availableFrom\": \"09:00\",\n    \"availableUntil\": \"18:00\",\n    \"blackoutDates\": []\n  },\n  \"images\": [\n    {\n      \"imageUrl\": \"https://example.com/jollof.jpg\",\n      \"altText\": \"Smoky Jollof Rice and Chicken\",\n      \"isCover\": true\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/meals"
          }
        },
        {
          "name": "Get Meals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/meals?search=&vendor=&kitchen=&category=&dietaryTag=&isAvailable=true&sort=popularity",
              "host": ["{{baseUrl}}"],
              "path": ["meals"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "vendor", "value": "" },
                { "key": "kitchen", "value": "" },
                { "key": "category", "value": "" },
                { "key": "dietaryTag", "value": "" },
                { "key": "isAvailable", "value": "true" },
                { "key": "sort", "value": "popularity" }
              ]
            }
          }
        },
        {
          "name": "Get Meal By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/meals/{{mealId}}"
          }
        },
        {
          "name": "Update Meal Variants",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variants\": [\n    {\n      \"name\": \"Regular\",\n      \"price\": 7500,\n      \"discountPrice\": 7000,\n      \"isDefault\": true,\n      \"isAvailable\": true\n    },\n    {\n      \"name\": \"Large\",\n      \"price\": 13500,\n      \"servingLabel\": \"serves 2-3\",\n      \"isAvailable\": true\n    }\n  ],\n  \"visibility\": \"published\",\n  \"dietaryTags\": [\"halal\", \"high-protein\"]\n}"
            },
            "url": "{{baseUrl}}/meals/{{mealId}}"
          }
        },
        {
          "name": "Delete Meal",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": "{{baseUrl}}/meals/{{mealId}}"
          }
        },
        {
          "name": "Get Popular Meals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/meals/popular?limit=10"
