          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"https://example.com/jollof-2.jpg\",\n  \"altText\": \"Another view of Smoky Jollof Rice and Chicken\",\n  \"isCover\": false\n}"
            },
            "url": "{{baseUrl}}/meals/{{mealId}}/images"
          }
        },
        {
          "name": "Update Meal Image",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
