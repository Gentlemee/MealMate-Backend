        },
        {
          "name": "Delete Meal Image",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": "{{baseUrl}}/meals/{{mealId}}/images/{{imageId}}"
          }
        }
      ]
    }
