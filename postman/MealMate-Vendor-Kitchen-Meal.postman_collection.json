            "url": "{{baseUrl}}/meals/{{mealId}}/availability"
          }
        },
        {
          "name": "Update Meal Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": true,\n  \"dailyStock\": 20,\n  \"remainingStock\": 12,\n  \"availableFrom\": \"09:00\",\n  \"availableUntil\": \"18:00\",\n  \"blackoutDates\": [\"2026-08-01\"]\n}"
            },
            "url": "{{baseUrl}}/meals/{{mealId}}/availability"
          }
        },
        {
